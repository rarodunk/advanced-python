__pycache__/

# Scratch wrappers written by the browser tests
_*.html

# Generated pages. Every version is rebuilt from its inputs by its own
# build.py, and the mosaic you fetch is yours, so committing the output only
# guarantees a merge conflict on the next pull. app/ is the exception: the
# Pages workflow serves it and checks it is in sync.
v3/index.html
v4/index.html

# The folder the deploy is assembled into, rebuilt on demand.
dist/

# Working files: art dropped in for import, and the zip make_site.py's output
# is packed into for a drag-and-drop deploy. Both are rebuilt or re-supplied,
# neither is an input the build reads.
scratchpad/
rarotonga-netlify.zip
